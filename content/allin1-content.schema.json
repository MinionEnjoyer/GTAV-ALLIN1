{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allin1.tools/schemas/content-v1.json",
  "title": "ALLIN1 content extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "api_version", "id", "name", "version"],
  "properties": {
    "schema_version": {"const": 1},
    "api_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$"}
    },
    "systems": {
      "type": "array",
      "items": {"$ref": "#/$defs/system"}
    },
    "gbay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
        "catalogs": {"type": "array", "items": {"$ref": "#/$defs/catalog"}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assemblies": {"type": "array", "items": {"$ref": "#/$defs/assembly"}}
      }
    },
    "workbench": {
      "$ref": "#/$defs/workbench"
    }
  },
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "default"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "label": {"type": "string", "minLength": 1},
        "type": {"enum": ["boolean", "integer", "number", "string", "choice"]},
        "default": {},
        "description": {"type": "string"},
        "group": {"type": "string"},
        "choices": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "config_key": {
          "type": "string",
          "pattern": "^(general|traffic|vehicles|script)\\.[a-z][a-z0-9_]*$"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "category": {"type": "string"},
        "experimental": {"type": "boolean"},
        "enabled_by_default": {"type": "boolean"},
        "settings": {"type": "array", "items": {"$ref": "#/$defs/setting"}}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "route"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "route": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,95}$"},
        "order": {"type": "integer"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
        "kind": {"enum": ["vehicle", "weapon", "gear", "service", "property"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "pattern": "^scripts/.+\\.dll$"},
        "entry_point": {"type": "string", "minLength": 1}
      }
    },
    "workbench": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weapon_enhancements": {
          "type": "array",
          "items": {"$ref": "#/$defs/weaponEnhancement"}
        }
      }
    },
    "weaponEnhancement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "mode", "weapon_components",
        "script_entry_points", "visual_assets"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
        "name": {"type": "string", "minLength": 1},
        "mode": {"const": "scripted_vanilla_components"},
        "weapon_components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/weaponComponentLink"}
        },
        "script_entry_points": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
          }
        },
        "visual_assets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/visualAssetProgression"}
        }
      }
    },
    "weaponComponentLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weapon_name", "weapon_hash", "component_name", "component_hash"
      ],
      "properties": {
        "weapon_name": {"type": "string", "pattern": "^WEAPON_.+"},
        "weapon_hash": {"type": "string", "pattern": "^(0x)?[0-9A-Fa-f]{8}$"},
        "component_name": {"type": "string", "pattern": "^COMPONENT_.+"},
        "component_hash": {"type": "string", "pattern": "^(0x)?[0-9A-Fa-f]{8}$"}
      }
    },
    "visualAssetProgression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dlc_pack", "archive", "families", "levels", "model_pattern",
        "texture_dictionary", "texture_pattern", "archetype_dictionary"
      ],
      "properties": {
        "dlc_pack": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "archive": {"type": "string", "minLength": 1},
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "levels": {"type": "integer", "minimum": 2, "maximum": 256},
        "model_pattern": {"type": "string", "minLength": 1},
        "base_model_pattern": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "texture_dictionary": {"type": "string", "minLength": 1},
        "texture_pattern": {"type": "string", "minLength": 1},
        "archetype_dictionary": {"type": "string", "minLength": 1},
        "base_level_uses_unsuffixed": {"type": "boolean"}
      }
    }
  }
}
