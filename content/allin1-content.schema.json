{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allin1.tools/schemas/content-v1.json",
  "title": "ALLIN1 content extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "api_version", "id", "name", "version"],
  "properties": {
    "schema_version": {"const": 1},
    "api_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$"}
    },
    "systems": {
      "type": "array",
      "items": {"$ref": "#/$defs/system"}
    },
    "gbay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
        "catalogs": {"type": "array", "items": {"$ref": "#/$defs/catalog"}}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assemblies": {"type": "array", "items": {"$ref": "#/$defs/assembly"}}
      }
    }
  },
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "default"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "label": {"type": "string", "minLength": 1},
        "type": {"enum": ["boolean", "integer", "number", "string", "choice"]},
        "default": {},
        "description": {"type": "string"},
        "group": {"type": "string"},
        "choices": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "config_key": {
          "type": "string",
          "pattern": "^(general|traffic|vehicles|script)\\.[a-z][a-z0-9_]*$"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "category": {"type": "string"},
        "experimental": {"type": "boolean"},
        "enabled_by_default": {"type": "boolean"},
        "settings": {"type": "array", "items": {"$ref": "#/$defs/setting"}}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "route"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "route": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,95}$"},
        "order": {"type": "integer"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
        "kind": {"enum": ["vehicle", "weapon", "gear", "service", "property"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "pattern": "^scripts/.+\\.dll$"},
        "entry_point": {"type": "string", "minLength": 1}
      }
    }
  }
}
