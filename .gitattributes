# This generated dependency inventory hashes exact bytes, including newlines.
# Windows checkout must not rewrite text companions after they are attested.
data/reactor/allin1-ui/** -text

# Tauri regenerates these source-owned permission contracts with LF endings.
desktop/src-tauri/permissions/autogenerated/*.toml text eol=lf

# These shared contract fixtures are compared byte-for-byte with the SDK.
tests/contract_fixtures/mod_packages/**/*.toml text eol=lf
tests/contract_fixtures/mod_packages/**/*.json text eol=lf
# The .bin fixtures intentionally contain plain text, not native assets.
tests/contract_fixtures/mod_packages/schema_v1/payload/ContractV1.bin text eol=lf
tests/contract_fixtures/mod_packages/schema_v2/payload/ContractV2.bin text eol=lf

# SDK-reserved model snapshots attest the exact source bytes of these catalogs.
data/vehicles.toml text eol=lf
data/story_vehicles.json text eol=lf
