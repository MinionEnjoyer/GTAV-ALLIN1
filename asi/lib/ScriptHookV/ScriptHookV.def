    scriptUnregister
    nativeInit
    nativePush64
    nativeCall
    getGlobalPtr
    worldGetAllVehicles
    worldGetAllPeds
    worldGetAllObjects
    worldGetAllPickups
    keyboardHandlerRegister
    keyboardHandlerUnregister
    presentCallbackRegister
    presentCallbackUnregister
    createTexture
    drawTexture
    getGameVersion
    getScriptHandleBaseAddress
