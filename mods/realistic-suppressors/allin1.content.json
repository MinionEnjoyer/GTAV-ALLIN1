  "id": "realistic-suppressors",
  "name": "Suppressors Enhanced",
  "version": "1.1.0",
  "description": "An independent Story Mode suppressor simulation with recommended ALLIN1 integration and an optional launcher-free build.",
  "capabilities": [
    "launcher.settings",
    "story-save.transactions",
    "weapon.components.lifecycle"
  ],
  "systems": [
    {
      "id": "realistic-suppressors",
      "name": "Suppressors Enhanced",
      "category": "Weapons",
      "description": "Witness-aware stealth plus weapon-specific suppressor heat, gradual center-out glow, critical smoke, wear, spark-pop failure, and replacement behavior.",
      "experimental": false,
      "enabled_by_default": true,
      "settings": [
        {
          "key": "realistic_suppressors",
          "label": "Realistic suppressor stealth",
          "type": "boolean",
          "default": true,
          "group": "Stealth",
          "description": "Suppressors reduce actionable gunshot noise without hiding close, visible, alerted, impact-adjacent, or sustained fire."
        },
        {
          "key": "suppressor_breakage",
          "label": "Suppressor wear and breakage",
          "type": "boolean",
          "default": true,
          "group": "Condition",
          "description": "Rapid overheating damages suppressors until they fail with a cosmetic spark and metallic pop, then must be replaced. Disable this to retain heat, glow, and smoke without permanent condition loss."
        },
        {
          "key": "suppressor_durability_scale",
          "label": "Suppressor durability multiplier",
          "type": "number",
          "default": 1.0,
          "minimum": 0.5,
          "maximum": 3.0,
          "step": 0.25,
          "group": "Condition",
          "description": "Scales suppressor life when breakage is enabled."
        },
        {
          "key": "suppressor_heat_smoke",
          "label": "Suppressor heat smoke",
          "type": "boolean",
          "default": true,
          "group": "Visuals",
          "description": "Adds can-attached barrel smoke with a pronounced density boost near critical suppressor temperature."
        },
        {
          "key": "suppressor_smoke_intensity",
          "label": "Heat smoke intensity",
          "type": "number",
          "default": 1.0,
          "minimum": 0.5,
          "maximum": 2.0,
          "step": 0.25,
          "group": "Visuals",
          "description": "Scales the size and density of suppressor heat-smoke trails."
        },
        {
          "key": "suppressor_temperature_debug",
          "label": "Temperature debug",
          "type": "boolean",
          "default": false,
          "group": "Diagnostics",
          "description": "Shows the equipped suppressor's live can temperature as a small HUD readout."
        }
      ]
    }
  ],
