<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ALLIN1</AssemblyName>
    <Version>0.6.7</Version>
    <AssemblyVersion>0.6.7.0</AssemblyVersion>
    <FileVersion>0.6.7.0</FileVersion>
    <RootNamespace>ALLIN1</RootNamespace>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <!-- The candidate manifest binds the reviewed commit and DLL SHA-256.
         Keep tracked runtime bytes reproducible across checkout locations and
         avoid a new binary-only commit changing its own informational hash. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/ALLIN1/script</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <Compile Remove="tests\**" />
    <Compile Remove="reactor-bridge\**" />
    <!-- Retained standalone experiment source is intentionally not shipped. -->
    <Compile Remove="..\archive\experimental-gameplay\native\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
